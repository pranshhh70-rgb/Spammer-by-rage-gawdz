--// Phrase & Emoji Pools
local Phrases = {
	"Tmx meh Mustang",
	"CXDAI BY V1CTOR",
	"Tmx meh Rage On Top",
	"SCRIPT MADE BY V1CTORFOUNDER_RAGE"
}

local Emojis = {"😍", "😭", "🤡", "😈", "🥴"}

--// Universal Chat Sender (Supports New TextChatService & Legacy Chat)
local function sendChatMessage(msg)
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local textChannels = TextChatService:FindFirstChild("TextChannels")
		local rbxGeneral = textChannels and textChannels:FindFirstChild("RBXGeneral")
		if rbxGeneral then
			rbxGeneral:SendAsync(msg)
		end
	else
		local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
		local sayMsg = chatEvents and chatEvents:FindFirstChild("SayMessageRequest")
		if sayMsg then
			sayMsg:FireServer(msg, "All")
		end
	end
end

--// Exact 164-Character Message Builder
local function buildSpamMessage(targetName, phraseIndex)
	local phrase = Phrases[phraseIndex]
	local emoji = Emojis[math.random(1, #Emojis)]
	local cleanTarget = (targetName ~= "" and targetName) or "Target"

	if usePrefix then
		local suffix = " (" .. cleanTarget .. ") " .. phrase .. " " .. emoji
		local suffixLen = utf8.len(suffix) or #suffix
		local atCount = math.max(1, 164 - suffixLen)
		local finalMsg = string.rep("@", atCount) .. suffix
		-- Enforce exact 164 character cap
		if (utf8.len(finalMsg) or #finalMsg) > 164 then
			finalMsg = string.sub(finalMsg, 1, 164)
		end
		return finalMsg
	else
		local base = "(" .. cleanTarget .. ") " .. phrase .. " " .. emoji .. " "
		local baseLen = utf8.len(base) or #base
		local padCount = math.max(0, 164 - baseLen)
		return base .. string.rep("@", padCount)
	end
end

--// Main Spammer Execution Loop
local isSpamming = false
local phraseIdx = 1

StartBtn.MouseButton1Click:Connect(function()
	isSpamming = not isSpamming

	if isSpamming then
		StartBtn.Text = "⏹ STOP RAGE SPAM"
		StartBtn.BackgroundColor3 = Color3.fromRGB(210, 45, 65)

		task.spawn(function()
			while isSpamming do
				-- Collect active targets from the 4 slots
				local activeTargets = {}
				for i = 1, 4 do
					local txt = TargetInputs[i].Text:match("^%s*(.-)%s*$")
					if txt ~= "" then
						table.insert(activeTargets, txt)
					end
				end

				if #activeTargets == 0 then
					table.insert(activeTargets, "Everyone")
				end

				for _, target in ipairs(activeTargets) do
					if not isSpamming then break end

					local message = buildSpamMessage(target, phraseIdx)
					StatusLabel.Text = "Sending -> " .. target .. " (" .. (utf8.len(message) or #message) .. " chars)"

					pcall(function()
						sendChatMessage(message)
					end)

					phraseIdx = (phraseIdx % #Phrases) + 1

					local delayTime = tonumber(DelayBox.Text) or 1.8
					if delayTime < 0.5 then delayTime = 0.5 end
					task.wait(delayTime)
				end
			end
		end)
	else
		StartBtn.Text = "▶ START RAGE SPAM"
		StartBtn.BackgroundColor3 = Color3.fromRGB(120, 45, 220)
		StatusLabel.Text = "Status: Stopped | Length Lock: 164 Chars"
	end
end)
